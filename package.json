{
  "name": "invariant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsc -p tsconfig.tools.json && node --test .invariant/compiled/tests/phase1.test.js .invariant/compiled/tests/repair.test.js .invariant/compiled/tests/workspace.test.js .invariant/compiled/tests/projects.test.js .invariant/compiled/tests/inventory.test.js",
    "verify": "tsc -p tsconfig.tools.json && node .invariant/compiled/scripts/verify.js",
    "repair": "tsc -p tsconfig.tools.json && node .invariant/compiled/scripts/repair.js",
    "project": "tsc -p tsconfig.tools.json && node .invariant/compiled/scripts/project.js"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
